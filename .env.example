# Server only. Never put these in public/ or commit a populated .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Local backup script only. Never required by Vercel.
SUPABASE_BACKUP_KEY=
ALLOWED_ADMIN_IDS=
# Exact URL, with no trailing slash. For local dev: http://localhost:4173
APP_ORIGIN=http://localhost:4173
KINOPOISK_API_KEY=
# Remain false until the database policies have been reviewed and secured.
ENABLE_WRITES=false
RLS_VERIFIED=false
PORT=4173
